datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model BusinessInfo {
  id            Int    @id @default(autoincrement())
  name          String @default("WellSight")
  tagline       String
  email         String
  phone         String
  whatsapp      String
  street        String
  postalCode    String
  city          String
  country       String
  countryCode   String
  hoursWeekdays String // e.g. "8:00 AM – 6:00 PM"
  hoursWeekend  String
}

model Service {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  shortDescription String
  duration         String
  fee              String // display text, e.g. "€90" or "€70–90"
  priceCents       Int? // exact amount used for Mollie Checkout; null = not billable online yet
  currency         String   @default("eur")
  includes         String
  status           String   @default("available") // "available" | "comingSoon"
  detail           String // paragraphs joined by \n\n
  sortOrder        Int      @default(0)
  updatedAt        DateTime @updatedAt

  slots             AvailabilitySlot[]
  bookings          Booking[]
  availabilityRules AvailabilityRule[]
}

model Package {
  id           String  @id @default(cuid())
  name         String
  description  String
  fee          String?
  originalFee  String?
  note         String?
  sortOrder    Int     @default(0)
}

model AvailabilitySlot {
  id        String   @id @default(cuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  format    String // "online" | "in-person"
  isBooked  Boolean  @default(false)
  booking   Booking?

  @@unique([serviceId, startsAt])
  @@index([startsAt])
}

// A weekly recurring rule ("Consultation, every Monday 09:00–17:00,
// online, 50-min sessions") that generates real AvailabilitySlot rows on a
// rolling window — see lib/availability.ts. Times are Europe/Helsinki
// wall-clock, converted to UTC instants at generation time (DST-aware).
model AvailabilityRule {
  id              String   @id @default(cuid())
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  dayOfWeek       Int // 0 = Sunday .. 6 = Saturday
  startTime       String // "09:00", Europe/Helsinki local
  endTime         String // "17:00", Europe/Helsinki local
  format          String // "online" | "in-person"
  durationMinutes Int      @default(50)
  createdAt       DateTime @default(now())
}

// A day (e.g. holiday, vacation) with no availability regardless of what
// the recurring rules would otherwise generate. Removes matching unbooked
// AvailabilitySlot rows when added.
model BlockedDate {
  id     String  @id @default(cuid())
  date   String  @unique // "YYYY-MM-DD", Europe/Helsinki local date
  reason String?
}

// Marks one specific rule-generated occurrence as intentionally removed
// (e.g. admin deleted "Tuesday 14:00" once) so the next generation pass
// doesn't recreate it — plain deletion alone isn't enough since the rule
// would just regenerate the same slot again.
model AvailabilityException {
  id        String   @id @default(cuid())
  serviceId String
  startsAt  DateTime
  createdAt DateTime @default(now())

  @@unique([serviceId, startsAt])
}

model Booking {
  id                String            @id @default(cuid())
  name              String
  email             String
  serviceId         String
  service           Service           @relation(fields: [serviceId], references: [id])
  slotId            String?           @unique
  slot              AvailabilitySlot? @relation(fields: [slotId], references: [id])
  format            String // "online" | "in-person"
  message           String?
  status            String            @default("pending") // "pending" | "confirmed" | "cancelled"
  paid              Boolean           @default(false)
  molliePaymentId   String?
  mollieCheckoutUrl String?
  googleEventId     String?
  createdAt         DateTime          @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  message   String?
  createdAt DateTime @default(now())
}

// Single-row connection to the psychologist's own Google Calendar, set up
// once from /admin/settings via OAuth — no manual token handling for her.
model GoogleCalendarConnection {
  id                   Int      @id @default(1)
  accountEmail         String
  refreshToken         String
  accessToken          String?
  accessTokenExpiresAt DateTime?
  calendarId           String   @default("primary")
  connectedAt          DateTime @default(now())
}

// Third-party API credentials, entered through /admin/settings instead of
// .env — the client manages her own Mollie/Google keys without ever opening
// a file. Single row (id=1).
model IntegrationSettings {
  id                 Int     @id @default(1)
  mollieApiKey       String?
  googleClientId     String?
  googleClientSecret String?

  // Outgoing mail (booking confirmations + payment links) via a regular
  // hosting mailbox (e.g. Plesk), not Gmail — the mailbox's own address
  // doubles as both the SMTP username and the "From" address.
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPassword String?
}

// Per-page <title>/meta description, editable from /admin/seo. Seeded from
// the Lot 3 keyword research; path is the route it applies to (e.g. "/",
// "/about-us"). Falls back to a hardcoded default if a row is missing.
model PageSeo {
  id          String   @id @default(cuid())
  path        String   @unique
  title       String
  description String
  updatedAt   DateTime @updatedAt
}

// Blog posts, editable from /admin/blog. English-only for now — body is
// plain paragraphs (blank line between), same convention as Service.detail.
model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  body        String
  status      String    @default("draft") // "draft" | "published"
  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt
}
